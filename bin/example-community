#!/bin/sh
set -eu
# Locate the source checkout or installed package.
site_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ ! -f "$site_root/main.tcl" ]; then
    package_root=
    for candidate in "$site_root"/lib/example-community*/main.tcl; do
        [ -f "$candidate" ] || continue
        if [ -n "$package_root" ]; then
            echo "Multiple example-community installations found under $site_root/lib." >&2
            exit 1
        fi
        package_root=${candidate%/main.tcl}
    done
    if [ -z "$package_root" ]; then
        echo "Cannot find example-community's main.tcl under $site_root." >&2
        exit 1
    fi
    site_root=$package_root
fi
if [ -n "${TCLSH:-}" ]; then
    exec "$TCLSH" "$site_root/main.tcl" "$@"
fi
# Prefer the consuming project's runtime, then Tcl 9.1 on PATH.
if [ -n "${PROJECT_INSTALL_DIR:-}" ]; then
    for interpreter in tclsh9.1 tclsh; do
        if [ -x "$PROJECT_INSTALL_DIR/bin/$interpreter" ]; then
            exec "$PROJECT_INSTALL_DIR/bin/$interpreter" "$site_root/main.tcl" "$@"
        fi
    done
fi
for interpreter in tclsh9.1 tclsh; do
    if command -v "$interpreter" >/dev/null 2>&1; then
        exec "$interpreter" "$site_root/main.tcl" "$@"
    fi
done
echo "Tcl 9.1 or newer is required." >&2
exit 1
