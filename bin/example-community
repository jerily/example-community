#!/bin/sh
# Locate an installed package or run directly from a checkout.
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -f "$SCRIPT_DIR/../main.tcl" ]; then
    exec "${TCLSH:-tclsh}" "$SCRIPT_DIR/../main.tcl" "$@"
fi
exec "${TCLSH:-tclsh}" "$SCRIPT_DIR/../lib/example-community0.1.0/main.tcl" "$@"
