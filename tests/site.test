package require tcltest
package require example-community
namespace import ::tcltest::*
test site-1 {site config can override layout independently; PROD fails closed without database config} -body {
    set ::env(ENV) LOCAL
    set a [::community::settings master_template {<main>{% block body %}{% endblock %}</main>}]
    set b [::community::settings]
    set ::env(ENV) PROD
    set result [list [expr {[dict get $a master_template] ne [dict get $b master_template]}] [catch {::web::user::connect {sqlite_path :memory:}}]]
    set ::env(ENV) INVALID
    lappend result [catch {::community::settings}]
    set ::env(ENV) LOCAL
    set result
} -result {1 1 1}

test site-2 {config supplies site identity, account policy, custom prefixes and explicit database options} -body {
    set ::env(ENV) LOCAL
    set c [::community::settings site_name {Another Garden} tenant garden account {totp_digits 8 bcrypt_cost 5} \
        user {prefix /members} forum {prefix /talk body_max_length 2000}]
    set values [::community::site_properties $c]
    list [dict get $c user issuer] [dict get $c account totp_digits] [dict get $c account tenant] \
        [dict get $values account_prefix] [dict get $values forum_prefix] [dict get $c postgresql]
} -result {{Another Garden} 8 garden {S /members} {S /talk} {}}
cleanupTests
